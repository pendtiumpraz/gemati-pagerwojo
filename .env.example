# ============================================================
# GEMATI Pagerwojo — Environment Variables (TEMPLATE)
# Salin file ini menjadi `.env` lalu isi nilai asli.
# JANGAN commit `.env` asli (sudah di-.gitignore).
# ============================================================

# --- Database: PostgreSQL (Neon / Vercel Postgres / Supabase) ---
# Ambil dari dashboard Neon (Connection string). Wajib.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Koneksi tanpa pgbouncer (untuk migrasi drizzle-kit). Opsional tapi disarankan.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST-UNPOOLED/DBNAME?sslmode=require

# --- Auth session secret ---
# WAJIB diisi string acak kuat (min 32 char). JANGAN pakai nilai contoh di bawah untuk production.
# Generate baru:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=9Byp4mavRvCgXuT1z9B-tKRldpeqSOg9ToaMHdYiR_dH2Cen1zkMkLMCzC4fn0e9

# --- PII encryption key (AES-256-GCM) untuk enkripsi NIK & No.HP at-rest ---
# WAJIB diisi. JANGAN DIUBAH setelah ada data terenkripsi (data lama tak bisa didekripsi).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PII_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64URL

# ============================================================
# Setelah mengisi .env:
#   npm install
#   npm run db:migrate     # buat tabel di database
#   npm run db:seed        # isi data awal (admin/admin123, dll)
#   npm run dev            # http://localhost:3000
# ============================================================
